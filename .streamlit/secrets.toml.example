# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud
# "Settings → Secrets" (recommended for cloud). NEVER commit the real file.

# Outreach comments backend (Supabase project settings → API)
[supabase]
url = "https://YOURPROJECT.supabase.co"
anon_key = "eyJ..."          # aka "publishable key" in the 2025+ dashboard

# Shared editor password — anyone holding it can add outreach notes.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(12))"
EDITOR_PASSWORD = "replace-me"

# NOTE: Google sign-in (st.login) needs a standard Google Cloud project —
# Express-mode accounts cannot create OAuth clients. Shared password is the
# default gate; revisit if a full GCP account ever gets set up.
