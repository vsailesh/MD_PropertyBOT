# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud
# "Settings → Secrets" (recommended for cloud). NEVER commit the real file.

# Outreach comments backend (Supabase project settings → API)
[supabase]
url = "https://YOURPROJECT.supabase.co"
anon_key = "eyJ..."          # aka "publishable key" in the 2025+ dashboard

# Editor allowlist — Google accounts allowed to add outreach notes.
EDITOR_EMAILS = ["you@gmail.com"]

# Google sign-in (Streamlit native auth). From Google Cloud Console →
# Google Auth Platform → Clients (project must be a standard project —
# Express-mode accounts cannot create OAuth clients).
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # add /<app> on Streamlit Cloud
cookie_secret = "generate: python -c \"import secrets; print(secrets.token_urlsafe(32))\""

[auth.google]
client_id = "000000000000-xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# While the OAuth app's publishing status is "Testing", only test users
# (Google Auth Platform → Audience) can sign in — add every editor email there too.
