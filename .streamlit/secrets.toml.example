# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud
# "Settings → Secrets" (recommended for cloud). NEVER commit the real file.
# NOTE: st.login config lives ONLY in secrets.toml — config.toml is ignored.

# Outreach comments backend (Supabase project settings → API)
[supabase]
url = "https://YOURPROJECT.supabase.co"
anon_key = "eyJ..."          # aka "publishable key" in the 2025+ dashboard

# Google sign-in for editors (st.login). Create at console.cloud.google.com:
# APIs & Services → OAuth client ID (Web application).
# redirect_uri must end with /oauth2callback and be listed in the Google
# OAuth client's authorized redirect URIs. Local dev:
#   http://localhost:8501/oauth2callback
# Streamlit Cloud (add BOTH to Google, keep cloud one here on deploy):
#   https://YOURAPP.streamlit.app/oauth2callback
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "any-long-random-string"   # e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"

[auth.google]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Email allowlist — anyone can SIGN IN, only these emails can COMMENT.
# Readers never need to log in.
EDITOR_EMAILS = ["you@gmail.com", "teammate@gmail.com"]
