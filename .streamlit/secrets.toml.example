# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud
# "Settings → Secrets" (recommended for cloud). NEVER commit the real file.

# Outreach comments backend (Supabase project settings → API)
[supabase]
url = "https://YOURPROJECT.supabase.co"
anon_key = "eyJ..."

# Editor gate — shared password people enter in the sidebar to unlock
# commenting. Readers see notes without it. Omit = commenting disabled.
EDITOR_PASSWORD = "choose-a-real-password"
